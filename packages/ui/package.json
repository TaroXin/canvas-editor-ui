{
  "name": "@baohu/canvas-editor-ui",
  "version": "1.1.0",
  "description": "Toolbar, statusbar and dialogs for @baohu/canvas-editor, framework-agnostic",
  "license": "MIT",
  "main": "./dist/canvas-editor-ui.umd.js",
  "module": "./dist/canvas-editor-ui.esm.js",
  "unpkg": "./dist/canvas-editor-ui.umd.js",
  "jsdelivr": "./dist/canvas-editor-ui.umd.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
