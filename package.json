{
  "name": "canvas-editor-ui-monorepo",
  "private": true,
  "version": "1.1.0",
  "description": "UI (toolbar, statusbar, dialogs) and framework wrappers for @baohu/canvas-editor",
  "scripts": {
    "dev": "pnpm build && pnpm --filter playground dev",
    "build": "pnpm --filter @baohu/canvas-editor-ui build && pnpm --filter @baohu/canvas-editor-vue2 build",
    "type:check": "pnpm -r type:check",
    "lint": "eslint .",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11"
  }
}
